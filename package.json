{
  "name": "jaboque-locacoes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "dev:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
    "dev:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-frontend.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:unix": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npm run start --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-frontend.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
